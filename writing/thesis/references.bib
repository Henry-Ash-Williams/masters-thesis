@article{vinayakumarRobustIntelligentMalware2019,
  title = {Robust {{Intelligent Malware Detection Using Deep Learning}}},
  author = {Vinayakumar, R. and Alazab, Mamoun and Soman, K. P. and Poornachandran, Prabaharan and Venkatraman, Sitalakshmi},
  year = {2019},
