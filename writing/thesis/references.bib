  author = {Botacin, Marcus and Ceschin, Fabricio and Sun, Ruimin and Oliveira, Daniela and Gr{\'e}gio, Andr{\'e}},
  year = {2021},
  month = jul,
  journal = {Computers \& Security},
  volume = {106},
