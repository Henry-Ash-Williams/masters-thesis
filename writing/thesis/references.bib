@article{usmanIntelligentDynamicMalware2021,
  title = {Intelligent {{Dynamic Malware Detection}} Using {{Machine Learning}} in {{IP Reputation}} for {{Forensics Data Analytics}}},
  author = {Usman, Nighat and Usman, Saeeda and Khan, Fazlullah and Jan, Mian Ahmad and Sajid, Ahthasham and Alazab, Mamoun and Watters, Paul},
  year = {2021},
