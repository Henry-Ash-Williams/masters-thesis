@inproceedings{nataraj2011malware,
  author    = {Nataraj, L. and Karthikeyan, S. and Jacob, G. and Manjunath, B. S.},
  title     = {Malware images: visualization and automatic classification},
  year      = {2011},
  isbn      = {9781450306799},
